# Copy to .env (git-ignored) for local runs. Production values live in Render env vars.
# IMPORTANT: DATABASE_URL must NOT contain an sslmode param — pg-connection-string
# turns ?sslmode=require into strict TLS that overrides the config below.
STORE_CORS=http://localhost:8000
ADMIN_CORS=http://localhost:9000
AUTH_CORS=http://localhost:9000
REDIS_URL=redis://127.0.0.1:6379
JWT_SECRET=change-me-to-a-random-string
COOKIE_SECRET=change-me-to-a-random-string
DATABASE_URL=postgresql://postgres.[ref]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
